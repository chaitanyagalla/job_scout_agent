# Explicit model selection always wins.
# Example Groq setup:
GROQ_API_KEY=your-groq-key-here
GEMINI_MODEL=groq/llama-3.3-70b-versatile

# Example NVIDIA NIM setup for the main chat model:
# NVIDIA_NIM_API_KEY=your-nvidia-key-here
# NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
# GEMINI_MODEL=nvidia_nim/nvidia/llama-3.3-nemotron-super-49b-v1.5
# JOB_SCOUT_RESUME_PARSER_MODEL=nvidia_nim/nvidia/llama-3.3-nemotron-super-49b-v1.5
# JOB_SCOUT_ALLOW_REASONING_MODEL=false
# JOB_SCOUT_INCLUDE_REASONING_PARTS=false
#
# If you use resume uploads, keep GOOGLE_API_KEY set too.
# Resume parsing now prefers the configured NVIDIA/Groq/OpenAI LiteLLM model for
# extracted resume text, then falls back to native Gemini only for attachment parsing.

# Example Gemini setup:
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash

GOOGLE_CLOUD_PROJECT=job-scout-agent-2026
GOOGLE_CLOUD_LOCATION=us-central1
APIFY_TOKEN=your-apify-token-optional

# Example Adzuna setup for job search:
# JOB_SCOUT_JOB_SEARCH_PROVIDER=adzuna
# ADZUNA_APP_ID=your-adzuna-app-id
# ADZUNA_APP_KEY=your-adzuna-app-key
# ADZUNA_COUNTRY=in

# Example BrowserAct setup for job search:
# JOB_SCOUT_JOB_SEARCH_PROVIDER=browseract
# BROWSERACT_API_KEY=your-browseract-api-key
# BROWSERACT_WORKFLOW_ID=your-published-browseract-workflow-id
# BROWSERACT_ROLE_PARAM=keyword
# BROWSERACT_LOCATION_PARAM=location
# BROWSERACT_LIMIT_PARAM=datalimit
# BROWSERACT_COUNTRY_PARAM=country
# BROWSERACT_TASK_TIMEOUT_SECONDS=180
# BROWSERACT_TASK_POLL_INTERVAL_SECONDS=2
